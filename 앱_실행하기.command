#!/bin/bash
# 티볼 타격 코치 — 실행 파일
#
# Finder에서 이 파일을 **더블클릭**하면 터미널이 열리고 프로그램이 실행됩니다.
# 관리자 비밀번호(맥 로그인 비밀번호)를 한 번 물어봅니다.
# 카메라를 다루려면 관리자 권한이 필요해서 그렇습니다.

cd "$(dirname "$0")" || exit 1

echo "======================================================================"
echo "  티볼 타격 자세 교정 프로그램"
echo "======================================================================"
echo ""

# 이미 실행 중인지 먼저 확인한다.
# 두 개를 동시에 켜면 서로 카메라를 빼앗아 촬영이 중간에 멈춘다.
if pgrep -f "venv/bin/python.* app.py" > /dev/null 2>&1; then
    echo "  ⚠ 프로그램이 이미 실행 중입니다."
    echo ""
    echo "  실행 중인 터미널 창을 찾아 Ctrl+C 로 종료한 뒤 다시 시도하세요."
    echo "  창을 못 찾겠으면 '앱_강제종료하기.command' 를 더블클릭하세요."
    echo ""
    echo "  이 창은 Enter 를 누르면 닫힙니다."
    read -r _
    exit 1
fi

echo "  잠시 뒤 브라우저가 자동으로 열립니다."
echo "  안 열리면 직접 이 주소를 여세요:  http://127.0.0.1:5050"
echo ""
echo "  ※ 카메라를 잡는 데 10~20초 걸립니다. 실패 메시지가 몇 번 떠도"
echo "     정상이며, 계속 다시 시도합니다."
echo ""
echo "  ※ 끝낼 때는 이 창에서  Ctrl + C  를 누르세요."
echo "     창을 그냥 닫으면 프로그램이 뒤에서 계속 돌아갑니다."
echo ""
echo "----------------------------------------------------------------------"
echo ""

# 프로그램이 뜨는 동안 브라우저를 열어둔다 (관리자 권한 전에 실행)
( sleep 4; open "http://127.0.0.1:5050" ) &

sudo ./venv/bin/python -u app.py

echo ""
echo "======================================================================"
echo "  프로그램이 종료되었습니다. 이 창은 닫아도 됩니다."
echo "======================================================================"
